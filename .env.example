# Discord webhook to post into (Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL)
DISCORD_WEBHOOK_URL=

# Upstash Redis (Vercel dashboard -> Storage -> Create Database -> Upstash Redis)
# These two are auto-added to your Vercel project's env vars when you create/connect the store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Vercel sets this automatically for Cron-triggered requests when you
# add CRON_SECRET as a project env var. Set any random string; used to reject
# requests to /api/check-exams that don't come from Vercel Cron.
CRON_SECRET=

# Static page listing exam-schedule documents (newest link first). Default
# is the department's actual page; only override for testing.
EXAMS_PAGE_URL=https://cs.uowm.gr/archiki-selida/programma-spoudwn/programma-exetaseon/
